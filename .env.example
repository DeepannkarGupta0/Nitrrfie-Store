# ==============================================================================
# ENVIRONMENT VARIABLES TEMPLATE (NIT Raipur Store & Operations Suite)
# ==============================================================================
# Copy this file to '.env' (or configure in your hosting platform's secret manager).
# NEVER commit real secrets or production '.env' files to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SERVER RUNTIME & PORTABILITY
# ------------------------------------------------------------------------------

# HTTP port listened on by server.ts (defaults to 3000; many PaaS hosts inject PORT)
PORT=3000

# OPTIONAL: Custom SQLite database file path (leave unset/blank to use the default ./data/store.db).
# Only set this if your hosting provider mounts a persistent disk outside the app directory (e.g., <mount-path>/store.db).
# STORE_DB_PATH=./data/store.db

# Comma-separated list of allowed origin hostnames or full URLs for API CORS/CSRF validation.
# Example: ALLOWED_ORIGINS=https://store.nitrrfie.in,https://www.store.nitrrfie.in
ALLOWED_ORIGINS=

# Public canonical URL used in confirmation emails and unsubscribe links
APP_PUBLIC_URL=https://store.nitrrfie.in

# ------------------------------------------------------------------------------
# 2. FRONTEND PUBLIC CONFIGURATION (Bundled into browser assets at Vite build)
# ------------------------------------------------------------------------------

# Clerk Authentication Publishable Key (pk_test_... or pk_live_...)
VITE_CLERK_PUBLISHABLE_KEY=pk_test_your_clerk_publishable_key_here

# Storefront UPI ID & WhatsApp Coordinator Phone (digits with country code)
VITE_STORE_UPI_ID=nitrrfie.store@sbi
VITE_COORDINATOR_PHONE=917974766166

# ------------------------------------------------------------------------------
# 3. SERVER-SIDE SECRETS (Strictly server-only, NEVER exposed to browser bundle)
# ------------------------------------------------------------------------------

# Clerk Secret Key (Required in production for authoritative JWT & staff lookup)
CLERK_SECRET_KEY=sk_test_your_clerk_secret_key_here

# High-entropy server-side Admin API key (Optional fallback for automation/maintenance)
ADMIN_SECRET_KEY=replace_with_32plus_char_random_secret

# Brevo Transactional Email API (Required for Newsletter confirmation emails)
BREVO_API_KEY=xkeysib-your_brevo_api_key_here
BREVO_SENDER_EMAIL=store@nitrrfie.in
BREVO_SENDER_NAME=NIT Raipur Store

# Google Gemini API Key (Optional - required only if using POST /api/gemini)
GEMINI_API_KEY=your_gemini_api_key_here
